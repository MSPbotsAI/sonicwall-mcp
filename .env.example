# Optional overrides — sonicwall-mcp has no required env vars.
# Authentication is per-request via headers (provided by the MCP caller):
#   X-Sonicwall-Msw-Api-Key   The customer's MySonicWall API key (generated at
#                             mysonicwall.com > My Workspace > User Groups >
#                             User list > Generate My API Key). This is the
#                             long-lived credential — ideally from a dedicated
#                             account whose NSM role is ReadOnly. This server
#                             does NOT talk to a customer's firewall directly;
#                             it only works if the firewall is managed through
#                             a SonicWall NSM SaaS tenant (see README).
#   X-Sonicwall-Tenant-Name   Optional. Only needed if this API key's MySonicWall
#                             account sees more than one tenant (e.g. an MSP
#                             account managing several customers) — a
#                             case-insensitive substring match against each
#                             tenant's name. Omit if the account sees exactly
#                             one tenant.
#   X-Sonicwall-Nsm-Region    Optional, defaults to "uswest". NSM SaaS is
#                             multi-region (maps to nsm-<region>.sonicwall.com,
#                             e.g. "eucentral" for Europe) — use whichever
#                             region the customer's NSM tenant is hosted in.
#
# This server runs the full MySonicWall-API-key -> NSM-bearer-token exchange
# itself on every request (three chained calls — see api_client.py) and never
# caches the resulting token, matching this fleet's stateless-per-call
# discipline for every other short/medium-lived-token vendor (datto-rmm-mcp,
# easydmarc-mcp, oitvoip-mcp, ingrammicro-mcp).

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
